# ── Original Little Fighter 2 game data — NEVER commit ───────────────────────
# The .dat files and sprites are © Marti Wong / Starsky Wong. The engine is
# ours; the game data is not. Users must supply their own copy of LF2.
data/
sprite/
bg/
*.dat
!sce_sys/**/*.dat

# ── Reference clones (OpenLF2 etc.) — consulta, não faz parte do build ───────
reference/

# ── Build artifacts ──────────────────────────────────────────────────────────
# BUILD/ = official VPKs (kept locally, not versioned); .build/ = intermediates
/BUILD/
/.build/
build/
build-out/
cmake-build-*/
*.o
*.a
*.elf
*.self
*.vpk
*.velf

# ── Host tools binaries ──────────────────────────────────────────────────────
/datdump
/test_dat
bin/

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# host SDL2 headers for compile-checking (tools/host_sdl.sh)
.sdlhost/
lf2vita.log

# Sprites do LF2 original — copyright Marti/Starsky Wong
assets/
!sce_sys/**/*.png

# ghidra-ai-bridge (regeraveis)
.ghidra-exports/
reference/ghidra/
.venv/
ghidra-bridge.yaml.bak

# Python caches
__pycache__/
*.pyc

# Codigo descompilado do lf2.exe (fase 2): derivado do exe, NUNCA no GitHub
