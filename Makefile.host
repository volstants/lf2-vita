# ─────────────────────────────────────────────────────────────────────────────
#  Host-side build — parser tools & tests. Nothing here targets the Vita;
#  use CMakeLists.txt + VitaSDK for the actual game build.
#
#    make -f Makefile.host test      run the parser test suite
#    make -f Makefile.host tools     build bin/datdump
#    make -f Makefile.host scan      validate every data/*.dat file
# ─────────────────────────────────────────────────────────────────────────────
CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -I src
BIN      := bin

.PHONY: all test tools scan clean check-assets check-main harness

# Type-check main.cpp against the REAL SDL2 headers (tools/host_sdl.sh fetches
# them without root). Hand-written ABI stubs were used before and are a bad
# trade: a wrong struct layout compiles fine and corrupts memory at runtime.
SDLHOST := .sdlhost/root/usr/include
check-main:
	@[ -d "$(SDLHOST)/SDL2" ] || ./tools/host_sdl.sh
	$(CXX) -std=c++17 -Wall -Wextra -fsyntax-only \
	  -I $(SDLHOST)/x86_64-linux-gnu -I $(SDLHOST) -I src src/main.cpp
	@echo "main.cpp OK (real SDL2 headers)"

# Headless harness: builds the REAL main.cpp for the host (LF2_HOST maps app0:/
# to the repo) and runs the actual game loop with scripted input under SDL's
# dummy video driver. One simulated tick per iteration, so 5 min of play takes
# about a second. This is what catches the class of bug that used to need a
# device round-trip: pool starvation, objects that stop retiring, crashes.
#
#   make -f Makefile.host harness            # 60 s of play
#   make -f Makefile.host harness TICKS=9000 # 5 min
TICKS ?= 1800
harness: | $(BIN)
	@[ -d "$(SDLHOST)/SDL2" ] || ./tools/host_sdl.sh
	$(CXX) -std=c++17 -O1 -Wall -Wextra -DLF2_HOST -DLF2_HEADLESS \
	  -I $(SDLHOST)/x86_64-linux-gnu -I $(SDLHOST) -I src src/main.cpp \
	  -o $(BIN)/lf2-headless \
	  -L .sdlhost/lib -L /lib/x86_64-linux-gnu -lSDL2-2.0 -lSDL2_image-2.0
	@SDL_VIDEODRIVER=dummy LD_LIBRARY_PATH=".sdlhost/lib:/lib/x86_64-linux-gnu" \
	  ./$(BIN)/lf2-headless $(TICKS)

all: tools test

$(BIN):
	@mkdir -p $(BIN)

tools: $(BIN)/datdump

$(BIN)/datdump: tools/datdump.cpp src/engine/dat.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_dat: tests/test_dat.cpp src/engine/dat.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_bg: tests/test_bg.cpp src/engine/dat.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_fighter: tests/test_fighter.cpp src/engine/fighter.hpp src/engine/dat.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_player: tests/test_player.cpp src/characters/player.hpp \
                    src/engine/fighter.hpp src/engine/dat.hpp src/engine/types.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_enemy: tests/test_enemy.cpp src/characters/enemy.hpp src/characters/player.hpp \
                   src/engine/fighter.hpp src/engine/dat.hpp src/engine/types.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

$(BIN)/test_object: tests/test_object.cpp src/engine/object.hpp src/characters/player.hpp \
                    src/engine/fighter.hpp src/engine/dat.hpp src/engine/types.hpp | $(BIN)
	$(CXX) $(CXXFLAGS) $< -o $@

test: $(BIN)/test_dat $(BIN)/test_bg $(BIN)/test_fighter $(BIN)/test_player $(BIN)/test_enemy $(BIN)/test_object
	@./$(BIN)/test_dat
	@echo ""
	@./$(BIN)/test_bg
	@echo ""
	@./$(BIN)/test_fighter
	@echo ""
	@./$(BIN)/test_player
	@echo ""
	@./$(BIN)/test_enemy
	@echo ""
	@./$(BIN)/test_object

# Runs the validator over the original game files (if present) and reports
# only hard errors. Warnings are quirks of the original data, not bugs.
scan: $(BIN)/datdump
	@if [ ! -d data ]; then echo "no data/ folder — nothing to scan"; exit 0; fi; \
	fail=0; \
	for f in data/*.dat; do \
	  ./$(BIN)/datdump "$$f" --validate || fail=1; \
	done; \
	echo "--- scan finished (exit $$fail)"

# Spritesheet integrity audit — run whenever new character .bmp enter the repo.
# Distinguishes benign end-of-RLE glitches from real content loss / short sheets.
check-assets:
	@python3 tools/check_assets.py

clean:
	rm -rf $(BIN)
